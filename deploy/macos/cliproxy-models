#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import urllib.request
state = Path.home() / '.config/cliproxyapi'
if not (state / 'config.yaml').exists():
    subprocess.run([str(Path.home() / '.local/bin/cliproxy-tunnel')], check=True)
request = urllib.request.Request('http://127.0.0.1:8317/v1/models', headers={
    'Authorization': 'Bearer ' + (state / 'client-key').read_text().strip()
})
with urllib.request.urlopen(request) as response:
    models = json.load(response).get('data', [])
for model in models:
    print(model['id'])
if not models:
    print('No models yet. Connect accounts in the console → OAuth Login.')
